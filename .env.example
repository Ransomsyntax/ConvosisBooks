# Local-only development values. Use secret values in production.
DJANGO_SECRET_KEY=replace-with-a-random-local-secret
DJANGO_DEBUG=1
POSTGRES_DB=convosisbooks
POSTGRES_USER=convosisbooks
POSTGRES_PASSWORD=local-only-change-this
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=your-brevo-smtp-login
EMAIL_HOST_PASSWORD=your-brevo-smtp-key
BREVO_SENDER_EMAIL=verified-sender@example.com
